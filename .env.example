# انسخ هذا الملف إلى .env.local محليًا، ونفس القيم في Vercel → Settings → Environment Variables

# ── إلزامي ──
# قاعدة بيانات Turso (أنشئها عبر: turso db create <name> ثم turso db tokens create <name>)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# عنوان خدمة دمج الفيديو (يُنشر من مجلد merger/ كمشروع Vercel منفصل، ثم ضع رابطه هنا)
MERGER_API_BASE=

# ── اختياري ──
# إن ضُبط يُطلب Authorization: Bearer <token> على مسار /mcp
MCP_ACCESS_TOKEN=

# تجاوز أسماء الموديلات إن لزم (الافتراضي مبني داخل الكود)
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
